# Convex deployment URL (required) — the realtime backend Arc talks to.
# Create a free deployment at https://convex.dev
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: passphrase for the local admin dashboard gate (/admin).
# NOTE: this is evaluated in the browser and is NOT a security boundary.
# Enforce real authorization server-side; never put a real secret here.
VITE_ADMIN_PASSWORD=

# Optional: Lemon Squeezy storefront id, only needed for the shop screens.
VITE_LEMON_SQUEEZY_STORE_ID=
